{
  "name": "ratchet-ui",
  "version": "0.1.0",
  "description": "The shared contract between agent-pipeline dashboards: wire types, runtime validators, and a token contract with no palette in it.",
  "license": "Apache-2.0",
  "author": "Vasiliy Mikhailov <vasiliy.mikhailov@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/vasiliy-mikhailov/ratchet-ui.git" },
  "homepage": "https://github.com/vasiliy-mikhailov/ratchet-ui#readme",
  "keywords": ["agent", "dashboard", "contract", "design-tokens", "types"],
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "sideEffects": ["*.css"],
  "files": ["dist", "src/tokens.css", "tsconfig.base.json", "README.md", "ADOPTING.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./wire": { "types": "./dist/wire.d.ts", "import": "./dist/wire.js" },
    "./check": { "types": "./dist/check.d.ts", "import": "./dist/check.js" },
    "./style": { "types": "./dist/style.d.ts", "import": "./dist/style.js" },
    "./tokens.css": "./src/tokens.css",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
